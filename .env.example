# ─────────────────────────────────────────────────────────────────────────
# Football Oracle — environment variables
#
# EVERY variable here is OPTIONAL. With an empty .env the app runs fully:
#   • predictions, simulations and explanations are 100% deterministic
#   • predictions persist to an in-memory store (no database needed)
#   • explanations use the built-in deterministic generator (no LLM needed)
# Add keys to unlock the enhanced path. Missing/invalid keys never break it.
# ─────────────────────────────────────────────────────────────────────────

# The Odds API — Phase 2B0 market recorder only. Never fed into pl-live-v0.2.0.
# One UK-region EPL h2h request per due poll. Unset = market UNCONFIGURED, forecasts continue.
ODDS_API_KEY=

# App URL (used for absolute links / metadata). Defaults to localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: protect /api/news/refresh. When set, the route requires
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron sends this header
# automatically when the env var exists, so the daily refresh keeps working;
# manual refreshes must supply the same bearer token. Unset = route stays open.
CRON_SECRET=

# MongoDB — agent memory (MongoDB Partner Track).
# If unset/unreachable, the app falls back to an in-process memory store.
MONGODB_URI=
MONGODB_DB=worldcup_oracle

# Google Gemini — premium escalation provider in the cost-aware LLM router
# (complex/ambiguous queries + DeepSeek fallback) AND the driver of the Gemini
# function-calling agent loop (lib/llm/geminiAgent.ts — Gemini chooses which
# deterministic tools to call). Either var name works (GEMINI_API_KEY from AI
# Studio or GOOGLE_API_KEY). If unset, DeepSeek (then the deterministic
# generator) is used instead and the tool loop is simply off. GEMINI_MODEL is
# optional — defaults to a current model; override if Google retires it.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to 0/off to force the Gemini function-calling tool loop off even with a key.
GEMINI_FUNCTION_CALLING=

# ── DeepSeek — optional hybrid LLM layer (ALL optional) ─────────────────────
# Active LLM in the production deploy: classifies ambiguous intent, writes the
# analyst narrative (structured result is its ONLY source of truth), and produces
# the Chinese answer. It never produces probabilities, news, injuries, or
# suspensions — those stay deterministic. If unset, the deterministic parser and
# templated explanations are used. Put the real key in .env.local / Vercel env —
# never commit it.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Live tournament state (OPTIONAL — set EITHER provider) ─────────────────
# Real fixtures/results are the DETERMINISTIC source of truth for whether a team
# is eliminated — the LLM/news layers never decide elimination. Results are
# cached aggressively in MongoDB (free-tier friendly). If neither key is set,
# the app runs in demo mode (all teams active, clearly labelled) and never
# falsely claims a team is eliminated.
#
# Option A — API-Football / API-SPORTS (fixtures + standings + injuries).
# Optional overrides: API_FOOTBALL_LEAGUE_ID (default 1 = World Cup),
# API_FOOTBALL_SEASON (default 2026).
API_FOOTBALL_KEY=
# Option B — football-data.org (v4, X-Auth-Token; fixtures/results — no injuries
# on the free tier). Used when API_FOOTBALL_KEY is not set. Optional override:
# FOOTBALL_DATA_COMPETITION (default WC = FIFA World Cup).
FOOTBALL_DATA_API_KEY=

# ── Daily news intelligence (ALL optional) ─────────────────────────────────
# Article/news context ONLY (injuries/squad). NOT used to decide elimination.
# Configure ANY ONE of these to pull live team news. The first one set wins.
# If NONE is set, the agent uses curated demo signals (clearly labelled in the
# UI as "Demo news data"). Missing/invalid keys never break predictions.
NEWS_API_KEY=
GNEWS_API_KEY=
SERPAPI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ─────────────────────────────────────────────────────────────────────────
# Live operations (Phase 2A / 2B0). All optional — unset means the local
# filesystem backend and no hosted scheduler, which is the correct setup for
# development and for `npm test`.
# ─────────────────────────────────────────────────────────────────────────

# Where the ops tick, job ledger and rating events persist. Unset auto-detects:
# "mongo" on Vercel when MONGODB_URI is set (serverless filesystems do not
# survive an invocation), otherwise "file". Explicit values:
#   "file"   — JSON/JSONL under data/processed/premier-league/ops/
#   "mongo"  — durable bundle in MongoDB
#   "bundle" — single-file bundle at PL_OPS_BUNDLE_PATH (used by tests)
PL_OPS_BACKEND=
# Scratch directory where the mongo/bundle backends stage the hydrated copy.
# Defaults to <tmpdir>/foa-durable-ops.
PL_DURABLE_WORK_DIR=

# Hosted scheduler (.github/workflows/ops-tick.yml). OPS_TICK_URL is read by
# scripts/ops-scheduler-worker.ts; the workflow reads the repo variable of the
# same name. CRON_SECRET above authenticates every tick.
OPS_TICK_URL=
# Worker tick cadence in ms (default 300000 = 5 minutes).
OPS_TICK_CADENCE_MS=
# Label reported by /api/health as the scheduler owner (e.g. "github-actions").
OPS_SCHEDULER_HOST=

# ── Phase 2B0 market recorder ──────────────────────────────────────────────
# The recorder is fully isolated from pl-live-v0.2.0: market prices are recorded
# and scored separately, never fed back into the forecast.
# "file" | "mongo" — where observations/consensus/poll jobs persist. Unset
# auto-detects the same way as PL_OPS_BACKEND (mongo on Vercel + MONGODB_URI).
MARKET_STORE_BACKEND=
# Directory for the file backend (default <ops dir>/market/).
MARKET_STORE_DIR=
# Set to 1 to stop the recorder running after an ops tick (forecasts continue).
MARKET_RECORDER_DISABLED=

# ── Big Five match ledger (Phase 2C) ───────────────────────────────────────
# The canonical 2026-27 match ledger for the Premier League, La Liga,
# Bundesliga, Serie A and Ligue 1. Reuses FOOTBALL_DATA_API_KEY above — no
# extra vendor. Without that key the ledger simply does not run; forecasts and
# every other subsystem continue unaffected.
#
# "file" | "mongo". Unset auto-detects mongo on Vercel with MONGODB_URI, else file.
MATCH_LEDGER_BACKEND=
# Directory for the file backend (default data/processed/big-five/).
MATCH_LEDGER_DIR=
# Minimum gap between ledger ingests, ms. Default 1800000 (30 min), clamped to
# 60s–24h. The ops tick runs every 5 minutes but a completed match stays
# completed, so re-reading five season schedules that often only burns quota.
MATCH_LEDGER_INTERVAL_MS=
# Set to 1 to stop the ledger running after an ops tick (forecasts continue).
MATCH_LEDGER_DISABLED=

# ── Shadow challenger freeze (pl-live-v0.3.0-shadow) ───────────────────────
# Default ON. Freezing is additive: a separate immutable record under a
# separate model version. Production always serves pl-live-v0.2.0.
# Set to 0/off/false to stop accumulating paired evidence.
SHADOW_MODEL_ENABLED=

# ── Live-source overrides (only if the defaults are wrong for your account) ─
# API-Football: league id (default 1 = World Cup) and season (default 2026).
API_FOOTBALL_LEAGUE_ID=
API_FOOTBALL_SEASON=
# football-data.org competition code (default WC = FIFA World Cup).
FOOTBALL_DATA_COMPETITION=
# Cache TTLs in ms for live fixtures / injuries. Defaults are free-tier safe:
# fixtures 7200000 (2h), injuries 28800000 (8h).
LIVE_FIXTURES_TTL_MS=
LIVE_INJURIES_TTL_MS=

# ─────────────────────────────────────────────────────────────────────────
# Test-only store overrides. Never set these in a deployed environment — they
# redirect canonical, audited artifacts. `npm test` sets them per suite so the
# frozen LIVE_OOS tape is never touched.
#
#   SNAPSHOT_STORE_PATH            durable prediction snapshots
#   SETTLEMENT_STORE_PATH          settled-result ledger
#   LIVE_OOS_ARCHIVE_PATH          committed LIVE_OOS tape
#   LIVE_OOS_ARCHIVE_ALLOW_APPEND  "1" lifts the append guard on that tape
#   SEASON_SIM_STORE_PATH          season simulation snapshots
#   PL_OPS_DIR / PL_OPS_BUNDLE_PATH / PL_TICK_LOCK_PATH
#   PL_FIXTURES_PATH / PL_FIXTURE_REVISIONS_PATH / PL_SEASON_MANIFEST_PATH
#   PL_CLUB_SEASONS_PATH / PL_RATING_STATE_PATH / PL_RATING_EVENT_PATH
#   PL_OPERATIONAL_LIVE_OOS_PATH
# ─────────────────────────────────────────────────────────────────────────
