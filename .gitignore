# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
tsconfig.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / tooling scratch left beside a file being written
*.tmpdir/
*.tmp

# python bytecode (betting-backtest also has its own .gitignore)
__pycache__/
*.pyc

# env files
.env
.env.local
.env*.local

# vercel
.vercel
.tmp-secrets/

# durable snapshot store (local writes; tests use SNAPSHOT_STORE_PATH)
/data/processed/predictions/snapshots.jsonl

# live-ops working state (never the canonical LIVE_OOS tape)
/data/processed/premier-league/ops/
/data/processed/premier-league/settlements.jsonl

# ops bundle exports (may contain production job/settlement state)
/ops-backups/

# Big Five match ledger working copy. Production accumulates into MongoDB;
# this local mirror is a backfill artifact that would diverge from it. The
# audited counts live in docs/PHASE2C_BIG_FIVE_LEDGER_REPORT.md.
/data/processed/big-five/
